{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Upstroke",
  "description": "One line of light climbs forever. Tap to reverse its sideways drift and thread it through the gaps in the falling bars.",
  "tags": ["arcade", "minimal", "one-tap", "reflex", "endless"],
  "permissions": ["haptics", "backgroundMusic", "storage"],
  "dependencies": [],
  "onboarding": {
    "kind": "immersive",
    "version": 1
  },
  "memory": {
    "records": {
      "distance": {
        "label": "Distance",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "feel": { "label": "Line Feel" },
      "difficulty": { "label": "Difficulty" },
      "visual": { "label": "Visual" },
      "audio": { "label": "Audio" }
    },
    "knobs": {
      "climb_speed": {
        "label": "Climb speed (screen widths per second)",
        "type": "number",
        "default": 0.55,
        "min": 0.3,
        "max": 0.95,
        "step": 0.05,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "turn_speed": {
        "label": "Sideways speed (screen widths per second)",
        "type": "number",
        "default": 0.62,
        "min": 0.3,
        "max": 1.1,
        "step": 0.02,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "turn_smoothing_ms": {
        "label": "Turn smoothing (ms)",
        "type": "number",
        "default": 55,
        "min": 0,
        "max": 180,
        "step": 5,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "starting_gap": {
        "label": "Starting gap width",
        "type": "percent",
        "default": 0.46,
        "min": 0.2,
        "max": 0.7,
        "step": 0.02,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "hit_margin": {
        "label": "Collision forgiveness (px)",
        "type": "number",
        "default": 2,
        "min": 0,
        "max": 6,
        "step": 0.5,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "line_color": {
        "label": "Line color",
        "type": "color",
        "default": "#8ff6ff",
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "bar_color": {
        "label": "Bar color",
        "type": "color",
        "default": "#ff2d55",
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "music_volume": {
        "label": "Music volume",
        "type": "percent",
        "default": 0.35,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "group": "audio",
        "intent": "audio",
        "apply": "live"
      }
    },
    "curves": {
      "difficulty_ramp": {
        "label": "Difficulty over time",
        "domain": "elapsed_seconds",
        "range": [0, 1.2],
        "default": [
          { "x": 0, "y": 0 },
          { "x": 20, "y": 0.16 },
          { "x": 60, "y": 0.48 },
          { "x": 120, "y": 0.82 },
          { "x": 240, "y": 1.2 }
        ],
        "easing": "smooth",
        "group": "difficulty",
        "apply": "live"
      }
    },
    "presets": {
      "gentle": {
        "label": "Gentle",
        "values": {
          "climb_speed": 0.45,
          "starting_gap": 0.56,
          "hit_margin": 3.5
        }
      },
      "sharp": {
        "label": "Sharp",
        "values": {
          "climb_speed": 0.7,
          "turn_speed": 0.8,
          "turn_smoothing_ms": 25,
          "starting_gap": 0.36,
          "hit_margin": 1
        }
      }
    }
  }
}
