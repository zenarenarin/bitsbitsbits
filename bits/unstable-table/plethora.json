{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "The Unstable Table",
  "description": "A painted still life on a seesaw. Drag ceramics, brass, glass and fruit onto a tabletop balanced on a single pivot. Real rigid-body physics: weight, leverage, friction and tall stacks all matter. Keep it level as the collection grows.",
  "tags": ["physics", "balance", "casual", "art", "endless"],
  "permissions": ["audio", "backgroundMusic", "haptics", "storage"],
  "dependencies": ["planck@1.5.0"],
  "display": "fullscreen",
  "onboarding": { "kind": "immersive", "version": 1 },
  "memory": {
    "records": {
      "score": {
        "label": "High Score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "balance": { "label": "Balance" },
      "pace": { "label": "Pace" },
      "sound": { "label": "Sound" }
    },
    "knobs": {
      "ballast_mass": { "label": "Ballast weight (higher = steadier table)", "type": "number", "default": 21, "min": 12, "max": 32, "step": 1, "group": "balance", "intent": "difficulty", "apply": "restart" },
      "table_damping": { "label": "Table damping (higher = less sway)", "type": "number", "default": 5, "min": 1, "max": 10, "step": 0.5, "group": "balance", "intent": "feel", "apply": "restart" },
      "safe_angle": { "label": "Safe tilt angle (degrees)", "type": "number", "default": 17, "min": 10, "max": 24, "step": 1, "group": "balance", "intent": "difficulty", "apply": "restart" },
      "arrival_start": { "label": "Time between arrivals at first", "type": "duration_ms", "default": 9000, "min": 4000, "max": 14000, "step": 500, "group": "pace", "intent": "difficulty", "apply": "restart" },
      "arrival_min": { "label": "Shortest time between arrivals", "type": "duration_ms", "default": 3200, "min": 2000, "max": 8000, "step": 200, "group": "pace", "intent": "difficulty", "apply": "restart" },
      "music_volume": { "label": "Music volume", "type": "number", "default": 0.32, "min": 0, "max": 0.9, "step": 0.02, "group": "sound", "intent": "audio", "apply": "restart" }
    }
  }
}
