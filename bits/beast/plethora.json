{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Beast",
  "description": "A tiny explorer climbs an impossibly enormous sleeping beast. Climb higher. Stay quiet.",
  "tags": [
    "adventure",
    "climbing",
    "atmospheric"
  ],
  "permissions": [],
  "dependencies": [],
  "onboarding": {
    "kind": "one_line",
    "version": 1,
    "message": "Hold left or right to climb. Swipe up to jump."
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "feel": {
        "label": "Movement feel"
      },
      "preview": {
        "label": "Testing"
      },
      "beast": {
        "label": "The beast"
      }
    },
    "knobs": {
      "walk_speed": {
        "label": "Careful pace",
        "type": "number",
        "default": 1,
        "min": 0.6,
        "max": 1.6,
        "step": 0.05,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "run_speed": {
        "label": "Faster pace",
        "type": "number",
        "default": 1,
        "min": 0.6,
        "max": 1.6,
        "step": 0.05,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "jump_height": {
        "label": "Jump height",
        "type": "number",
        "default": 1,
        "min": 0.6,
        "max": 1.5,
        "step": 0.05,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "noise_scale": {
        "label": "How easily it wakes",
        "type": "number",
        "default": 1,
        "min": 0.4,
        "max": 2,
        "step": 0.05,
        "group": "beast",
        "intent": "difficulty",
        "apply": "live"
      },
      "recovery_rate": {
        "label": "How fast it settles",
        "type": "number",
        "default": 1,
        "min": 0.4,
        "max": 2,
        "step": 0.05,
        "group": "beast",
        "intent": "difficulty",
        "apply": "live"
      },
      "start": {
        "label": "Start on",
        "type": "choice",
        "default": "back",
        "options": [
          "base",
          "back",
          "head"
        ],
        "group": "preview",
        "intent": "debug",
        "apply": "live"
      },
      "collision_overlay": {
        "label": "Show collision on the body",
        "type": "boolean",
        "default": false,
        "group": "preview",
        "intent": "debug",
        "apply": "live"
      },
      "show_alertness": {
        "label": "Show alertness readout",
        "type": "boolean",
        "default": false,
        "group": "preview",
        "intent": "debug",
        "apply": "live"
      }
    }
  }
}
