{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Orientation",
  "description": "A tiny bead of light on a filament suspended in the dark. You never touch the ball — you tilt the world underneath it. Eleven worlds that grow quietly stranger.",
  "tags": ["interactive-art", "physics", "gravity", "meditative", "light"],
  "permissions": ["audio"],
  "dependencies": [],
  "game": {
    "progress": {
      "main": { "label": "Worlds", "stateSchemaVersion": 1, "ttlDays": 120 }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "physics": { "label": "Physics" },
      "look": { "label": "Look & sound" },
      "debug": { "label": "Testing" }
    },
    "knobs": {
      "gravity": { "label": "Gravity", "type": "number", "default": 210, "min": 120, "max": 340, "step": 5, "group": "physics", "intent": "feel", "apply": "live" },
      "groove_hold": { "label": "How firmly the filament holds the ball", "type": "number", "default": 1, "min": 0.6, "max": 1.6, "step": 0.05, "group": "physics", "intent": "difficulty", "apply": "live" },
      "world_inertia": { "label": "World inertia", "type": "number", "default": 1, "min": 0.4, "max": 3, "step": 0.1, "group": "physics", "intent": "feel", "apply": "live" },
      "rotation_sensitivity": { "label": "Rotation sensitivity", "type": "number", "default": 1, "min": 0.5, "max": 2, "step": 0.05, "group": "physics", "intent": "feel", "apply": "live" },
      "haze": { "label": "Atmospheric haze", "type": "number", "default": 1, "min": 0, "max": 2, "step": 0.1, "group": "look", "intent": "visual", "apply": "live" },
      "grain": { "label": "Film grain", "type": "number", "default": 1, "min": 0, "max": 2, "step": 0.1, "group": "look", "intent": "visual", "apply": "live" },
      "volume": { "label": "Sound volume", "type": "number", "default": 0.8, "min": 0, "max": 1, "step": 0.05, "group": "look", "intent": "audio", "apply": "live" },
      "start_level": { "label": "Start at world", "type": "integer", "default": 1, "min": 1, "max": 11, "step": 1, "group": "debug", "intent": "debug", "apply": "restart" }
    }
  },
  "onboarding": { "kind": "immersive", "version": 1 }
}
