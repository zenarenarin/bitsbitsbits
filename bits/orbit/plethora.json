{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "ORBIT",
  "description": "A daily circular logic puzzle. Turn four colour rings so that marked intersections hold: triples, pairs, contrasts, sequences, the odd one out. Solve three clues and two more appear; solve those and the last two arrive. Find the one arrangement that satisfies all seven.",
  "tags": [
    "puzzle",
    "daily",
    "logic",
    "colour",
    "art"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "storage"
  ],
  "dependencies": [],
  "display": "fullscreen",
  "onboarding": {
    "kind": "immersive",
    "version": 1
  },
  "game": {
    "progress": {
      "daily": {
        "label": "Today's ORBIT",
        "stateSchemaVersion": 2,
        "ttlDays": 2
      }
    }
  },
  "memory": {
    "local": {
      "profile": {
        "label": "Collection, streak and practice"
      }
    },
    "records": {
      "solve_time": {
        "label": "Fastest Solve",
        "valueType": "duration_ms",
        "order": "asc",
        "format": "timer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      },
      "streak": {
        "label": "Daily Streak",
        "valueType": "streak",
        "order": "desc",
        "format": "integer",
        "periods": [
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  }
}
