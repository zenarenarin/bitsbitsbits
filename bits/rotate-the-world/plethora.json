{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Rotate the World",
  "description": "A playable kinetic sculpture. Turn an impossible porcelain object with one finger; gravity stays put, and a small light trapped in glass finds its way through eight rooms of folds, water, growth and darkness.",
  "tags": ["physics", "puzzle", "art", "sculpture", "gravity"],
  "permissions": ["audio", "haptics"],
  "dependencies": ["three@0.164.1"],
  "game": {
    "progress": {
      "main": {
        "label": "Sculpture",
        "stateSchemaVersion": 1,
        "ttlDays": 120
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "feel": { "label": "Feel" },
      "visual": { "label": "Visual" },
      "audio": { "label": "Audio" },
      "debug": { "label": "Draft tools" }
    },
    "knobs": {
      "gravity": {
        "label": "Gravity",
        "type": "number",
        "default": 20,
        "min": 12,
        "max": 30,
        "step": 1,
        "group": "feel",
        "intent": "feel",
        "apply": "restart"
      },
      "rotation_inertia": {
        "label": "Turn inertia after release",
        "type": "percent",
        "default": 0.22,
        "min": 0,
        "max": 0.5,
        "step": 0.02,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "snap_strength": {
        "label": "Settle strength",
        "type": "number",
        "default": 9,
        "min": 4,
        "max": 16,
        "step": 0.5,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "water_amount": {
        "label": "Water in reservoirs",
        "type": "number",
        "default": 1,
        "min": 0.6,
        "max": 1.2,
        "step": 0.05,
        "group": "feel",
        "intent": "gameplay",
        "apply": "restart"
      },
      "accent_color": {
        "label": "Light color",
        "type": "color",
        "default": "#ffab5e",
        "group": "visual",
        "intent": "visual",
        "apply": "restart"
      },
      "ball_glow": {
        "label": "Ball glow",
        "type": "percent",
        "default": 0.75,
        "min": 0.2,
        "max": 1,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "sound_volume": {
        "label": "Sound volume",
        "type": "percent",
        "default": 0.8,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "group": "audio",
        "intent": "audio",
        "apply": "restart"
      },
      "start_level": {
        "label": "Start at room (0 = saved progress)",
        "type": "integer",
        "default": 0,
        "min": 0,
        "max": 8,
        "step": 1,
        "group": "debug",
        "intent": "debug",
        "apply": "restart"
      }
    }
  },
  "onboarding": {
    "kind": "immersive",
    "version": 1
  }
}
