{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Egg Drop",
  "description": "A painted balancing toy. One egg rests on a tilting platform; slide the brass counterweight along its rail to shift the balance and keep the egg from rolling off. Real rigid-body physics, four surfaces from grippy rubber to slippery metal.",
  "tags": ["arcade", "physics", "balance", "survival", "tactile"],
  "permissions": ["haptics", "audio", "backgroundMusic", "storage", "motion"],
  "dependencies": ["planck@1.5.0"],
  "display": "fullscreen",
  "onboarding": {
    "kind": "immersive",
    "version": 1
  },
  "memory": {
    "records": {
      "time": {
        "label": "Longest Balance",
        "valueType": "duration_ms",
        "order": "desc",
        "format": "timer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user",
        "dimensions": { "surface": ["rubber", "wood", "ceramic", "metal"] }
      },
      "score": {
        "label": "Balance Points",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user",
        "dimensions": { "surface": ["rubber", "wood", "ceramic", "metal"] }
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "physics": { "label": "Physics" },
      "difficulty": { "label": "Difficulty" },
      "audio": { "label": "Audio" }
    },
    "knobs": {
      "disturbance_strength": { "label": "Disturbance strength", "type": "number", "default": 1, "min": 0.4, "max": 1.8, "step": 0.05, "group": "difficulty", "intent": "difficulty", "apply": "restart" },
      "gravity_scale": { "label": "Gravity", "type": "number", "default": 1, "min": 0.7, "max": 1.3, "step": 0.05, "group": "physics", "intent": "feel", "apply": "restart" },
      "platform_damping": { "label": "Platform damping", "type": "number", "default": 0.55, "min": 0.2, "max": 1.5, "step": 0.05, "group": "physics", "intent": "feel", "apply": "restart" },
      "counterweight_mass": { "label": "Counterweight mass (kg)", "type": "number", "default": 0.95, "min": 0.7, "max": 1.3, "step": 0.05, "group": "physics", "intent": "gameplay", "apply": "restart" },
      "music_volume": { "label": "Music volume", "type": "number", "default": 0.32, "min": 0, "max": 0.7, "step": 0.02, "group": "audio", "intent": "audio", "apply": "restart" }
    }
  }
}
