{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Resonance",
  "description": "A black field of luminous matter that answers touch with real waves. Recall a fleeting formation of light and recreate it by making waves interfere.",
  "tags": [
    "puzzle",
    "physics",
    "generative-art",
    "light",
    "touch",
    "sound"
  ],
  "permissions": [
    "audio",
    "haptics"
  ],
  "dependencies": [],
  "onboarding": {
    "kind": "guided",
    "version": 2,
    "replayable": true,
    "steps": [
      {
        "id": "touch",
        "title": "Touch the dark",
        "body": "A tap sends a wave of light through the field. Press a little longer before letting go and the wave is heavier.",
        "advance": "interaction"
      },
      {
        "id": "meet",
        "title": "Where waves meet, light stays",
        "body": "Crossing waves leave bright lines behind, like a long exposure. Those lines are the patterns you will be making.",
        "advance": "continue"
      },
      {
        "id": "recall",
        "title": "Remember the shape",
        "body": "Each level flashes a formation of light for a moment, then it fades. Recreate it from memory. The closer you get, the brighter it answers and the higher your resonance climbs.",
        "advance": "continue"
      },
      {
        "id": "gestures",
        "title": "Hold, drag, flick, pinch",
        "body": "Hold until your touch sings: it keeps making waves. Drag it to bend them. Flick to throw a wave. Two fingers make two sources; pinch or spread to slow or quicken the field.",
        "advance": "continue"
      },
      {
        "id": "energy",
        "title": "Resonance",
        "body": "Match the formation to move on. Every wave costs energy, so use as few as you can. Lose it all and the field fades: retrace to see the shape again. Tap ? anytime to read this again.",
        "advance": "continue"
      }
    ]
  },
  "memory": {
    "records": {
      "total": {
        "label": "Resonance",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      }
    }
  },
  "game": {
    "progress": {
      "main": {
        "label": "Resonance run",
        "stateSchemaVersion": 1,
        "ttlDays": 60
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "gameplay": {
        "label": "Gameplay"
      },
      "visual": {
        "label": "Light"
      },
      "audio": {
        "label": "Sound"
      }
    },
    "knobs": {
      "tolerance": {
        "label": "Match tolerance (negative is easier)",
        "type": "number",
        "default": 0,
        "min": -0.2,
        "max": 0.1,
        "step": 0.01,
        "group": "gameplay",
        "intent": "difficulty",
        "apply": "live"
      },
      "reveal_scale": {
        "label": "Formation reveal length",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.05,
        "group": "gameplay",
        "intent": "difficulty",
        "apply": "live"
      },
      "wave_speed": {
        "label": "Wave speed",
        "type": "number",
        "default": 1,
        "min": 0.7,
        "max": 1.3,
        "step": 0.05,
        "group": "gameplay",
        "intent": "feel",
        "apply": "restart"
      },
      "particle_density": {
        "label": "Particle density",
        "type": "number",
        "default": 1,
        "min": 0.3,
        "max": 1.6,
        "step": 0.1,
        "group": "visual",
        "intent": "visual",
        "apply": "restart"
      },
      "trail_persistence": {
        "label": "Trail persistence",
        "type": "number",
        "default": 0.6,
        "min": 0,
        "max": 0.9,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "bloom_strength": {
        "label": "Bloom and haze",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "chromatic_aberration": {
        "label": "Spectral fringe",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2.5,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "grain": {
        "label": "Film grain",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "exposure": {
        "label": "Exposure",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 1.8,
        "step": 0.05,
        "group": "visual",
        "intent": "visual",
        "apply": "live"
      },
      "audio_volume": {
        "label": "Volume",
        "type": "number",
        "default": 0.7,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "group": "audio",
        "intent": "audio",
        "apply": "live"
      }
    }
  }
}