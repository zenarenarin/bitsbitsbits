{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "DEAD FLOORS",
  "description": "A first-person zombie survival shooter. The horde rushes you in a dark, abandoned building and ammo is scarce: scavenge boxes, land headshots, find weapon crates and survive the boss that comes every three minutes. Your score is how long you last. Left thumb moves, drag to aim, hold FIRE.",
  "tags": [
    "shooter",
    "fps",
    "zombies",
    "survival",
    "3d",
    "horror",
    "action"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "storage"
  ],
  "dependencies": [
    "three@0.164.1"
  ],
  "display": "fullscreen",
  "onboarding": {
    "kind": "one_line",
    "version": 2,
    "message": "Left thumb moves, drag right to aim, hold FIRE. Ammo is scarce: aim for heads."
  },
  "memory": {
    "records": {
      "survival": {
        "label": "Seconds survived",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "feel": {
        "label": "Feel"
      },
      "difficulty": {
        "label": "Difficulty"
      }
    },
    "knobs": {
      "aim_assist": {
        "label": "Aim assist strength",
        "type": "number",
        "default": 1,
        "min": 0,
        "max": 2,
        "step": 0.1,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "look_speed": {
        "label": "Look sensitivity",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.05,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "difficulty_ramp": {
        "label": "How fast the horde grows over time",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "restart"
      },
      "ammo_drops": {
        "label": "Ammo supply (box respawn and drops)",
        "type": "number",
        "default": 1,
        "min": 0.3,
        "max": 2,
        "step": 0.1,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      }
    }
  }
}
