{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "HOLE",
  "description": "Carry a living 3D aperture. What it swallows changes its shape — and its shape decides what it can swallow next. Drag or tilt to steer.",
  "tags": ["arcade", "3d", "shapes", "motion", "endless"],
  "permissions": ["motion", "haptics", "backgroundMusic"],
  "dependencies": ["three@0.164.1"],
  "onboarding": { "kind": "immersive", "version": 1 },
  "memory": {
    "records": {
      "score": {
        "label": "Score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user"
      }
    }
  }
}
