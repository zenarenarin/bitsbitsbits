{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Glass Drift",
  "description": "Drift through six architectural glass worlds with swinging pendulums, sliding doors and spinning rotors. Thick glass cracks before it breaks, rare crystals give more balls, and every level ends at a door.",
  "tags": [
    "arcade",
    "3d",
    "relaxing"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics"
  ],
  "dependencies": [
    "three@0.164.1"
  ],
  "onboarding": {
    "kind": "one_line",
    "version": 3,
    "message": "Tap to throw balls. Lead the moving glass!"
  },
  "memory": {
    "records": {
      "score": {
        "label": "High Score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  }
}
