{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "The Reflection",
  "description": "A small black cat, an antique mirror, and a reflection that slowly stops following. Keep in sync with it for as long as you can.",
  "tags": ["arcade", "horror", "3d", "rhythm", "endless"],
  "permissions": ["haptics", "audio", "storage"],
  "dependencies": ["three@0.164.1"],
  "onboarding": {
    "kind": "one_line",
    "version": 1,
    "message": "Move with 1–5 or the buttons. When it moves first, copy it."
  },
  "memory": {
    "records": {
      "score": {
        "label": "High Score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": ["daily", "weekly", "all_time"],
        "scopes": ["following", "global"],
        "dedupe": "best_per_user"
      }
    }
  }
}
